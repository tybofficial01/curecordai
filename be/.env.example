
# ── App ──────────────────────────────────────────────────────────
APP_ENV=development                    # development | staging | production
APP_NAME=CurecordAI
APP_VERSION=1.0.0
APP_DEBUG=false                        # NEVER true in production - enables SQL echo (incl. bound params, which can include PHI) to logs
SECRET_KEY=CHANGE_ME                   # Generate with: openssl rand -hex 32
FIELD_ENCRYPTION_KEY=CHANGE_ME         # AES-256 key for encrypting sensitive DB fields. Generate with: python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
ALLOWED_HOSTS=http://localhost:3000,http://localhost:8080
TRUSTED_PROXY_IPS=                     # Comma-separated proxy IPs allowed to set X-Forwarded-For. Empty = always trust the raw socket IP (safe default with no reverse proxy deployed)

# ── Database (PostgreSQL) ─────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_SSL=true
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_SIZE=5

# email settings for sending emails (e.g., for password resets)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=CHANGE_ME          # Gmail App Password - https://myaccount.google.com/apppasswords

# ── JWT (RS256) ───────────────────────────────────────────────────
# Generate with: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ALGORITHM=RS256

# ── AWS ───────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_DEFAULT_REGION=ap-south-1          # ap-south-1 (Mumbai) or me-south-1 (Bahrain) for Pakistan users
AWS_S3_BUCKET_NAME=curecordai-documents
AWS_S3_PRESIGNED_URL_EXPIRY_SECONDS=900   # 15 minutes

# ── Twilio (SMS OTP) ─────────────────────────────────────────────
TWILIO_ACCOUNT_SID=CHANGE_ME
TWILIO_AUTH_TOKEN=CHANGE_ME
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_LENGTH=6

# ── WhatsApp (Meta Cloud API) ─────────────────────────────────────
META_WA_APP_SECRET=CHANGE_ME
META_WA_ACCESS_TOKEN=CHANGE_ME
META_WA_PHONE_NUMBER_ID=CHANGE_ME
META_WA_VERIFY_TOKEN=CHANGE_ME
META_WA_API_VERSION=v26.0
WA_CONFIRMATION_CODE_EXPIRE_MINUTES=10
WA_ACTIVE_PROFILE_IDLE_RESET_MINUTES=120
RATE_LIMIT_WHATSAPP_PER_MINUTE=6

# ── Soniox (voice note transcription) ─────────────────────────────
SONIOX_API_KEY=CHANGE_ME

# ── OpenRouter (AI) ──────────────────────────────────────────────
OPENROUTER_API_KEY=CHANGE_ME
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Configurable model per use-case
AI_EXTRACTION_MODEL=anthropic/claude-sonnet-4-6     # Document OCR + clinical entity extraction
AI_SUMMARY_MODEL=anthropic/claude-haiku-4-5-20251001  # Per-document AI summary (fast, cost-efficient)
AI_CHAT_MODEL=anthropic/claude-sonnet-4-6           # AI chat assistant (context-aware)
AI_EMBEDDING_MODEL=openai/text-embedding-3-small    # Document chunk + chat query embeddings (RAG)
AI_EMBEDDING_DIMENSIONS=1536

AI_MAX_TOKENS_SUMMARY=1000
AI_MAX_TOKENS_EXTRACTION=2000
AI_MAX_TOKENS_CHAT=2000
AI_MAX_TOKENS_HISTORY_SUMMARY=1500

# ── Google OAuth ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME

# ── Apple Sign In ─────────────────────────────────────────────────
APPLE_CLIENT_ID=CHANGE_ME
APPLE_TEAM_ID=CHANGE_ME
APPLE_KEY_ID=CHANGE_ME
APPLE_PRIVATE_KEY_PATH=./keys/apple_auth.p8

# ── AWS SES (Email) ───────────────────────────────────────────────
SES_FROM_EMAIL=noreply@curecordai.com
SES_FROM_NAME=CurecordAI
CONTACT_INBOX_EMAIL=support@curecordai.com

# ── Rate Limiting ─────────────────────────────────────────────────
RATE_LIMIT_OTP_PER_HOUR=5             # Max OTP requests per phone per hour
RATE_LIMIT_API_PER_MINUTE=100         # General API rate limit per user/IP
RATE_LIMIT_UPLOAD_PER_HOUR=20         # Max document uploads per hour
REDIS_URL=                             # e.g. redis://host:6379/0 - required once running more than one app process/instance, otherwise each process rate-limits independently
LOGIN_LOCKOUT_MAX_ATTEMPTS=10          # Failed password attempts before an account is temporarily locked
LOGIN_LOCKOUT_MINUTES=15

# ── File Upload ───────────────────────────────────────────────────
MAX_FILE_SIZE_MB=50
ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,image/webp,application/dicom

# ── Doctor QR Sharing ─────────────────────────────────────────────
QR_SESSION_EXPIRE_MINUTES=10
WEB_APP_BASE_URL=https://app.curecordai.com          # Public frontend URL the QR code links to (/share/{token})

# ── GDPR / Compliance ─────────────────────────────────────────────
GDPR_ERASURE_GRACE_PERIOD_DAYS=30
DATA_EXPORT_FILE_EXPIRY_HOURS=48

# ── Monitoring ────────────────────────────────────────────────────
SENTRY_DSN=                            # Optional: Sentry error tracking DSN
LOG_LEVEL=INFO


ICD11_CLIENT_ID=CHANGE_ME
ICD11_CLIENT_SECRET=CHANGE_ME