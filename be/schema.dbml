// ================================================================
// CurecordAI - Production-Grade ERD (DBML)
// Schema Version: 1.1  |  Last verified: June 2026
// ================================================================
// Standards Applied (all verified against live authoritative sources):
//
//   • FHIR R4 - Patient, Observation, MedicationRequest,
//                     Condition, DocumentReference, AllergyIntolerance,
//                     Encounter, AuditEvent (IHE BALP IG)
//                     Source: hl7.org/fhir/R4
//
//   • ICD-11 - Stem codes (format: 1A00.00–ZZ9Z.ZZ, 4–6 chars)
//                     Post-coordination via stem/extension clusters
//                     Source: WHO ICD-11 Reference Guide + atcddd.fhi.no
//
//   • LOINC - Numeric code + hyphen + check digit (e.g. 2339-0)
//                     Six-axis meaning: component, property, time, system,
//                     scale, method
//                     Source: Regenstrief Institute loinc.org
//
//   • WHO ATC - Exactly 7-char alphanumeric, 5 levels
//                     (e.g. A10BA02 = metformin)
//                     Source: WHO Collaborating Centre, atcddd.fhi.no
//                     Verified: 2026 Guidelines for ATC Classification
//
//   • SNOMED CT - Clinical terminology (allergy substance, condition)
//
//   • Pakistan PDPB - ⚠️  Personal Data Protection Bill 2023 (draft).
//                     As of June 2026, NOT yet enacted law - approved by
//                     Federal Cabinet but NOT passed both houses of
//                     Parliament. 72-hour breach notification is proposed,
//                     not yet legally enforceable.
//                     Source: recordinglaw.com + ICNL PDPB 2023 PDF
//                     → Design conservatively: treat proposed requirements
//                       as binding to avoid retrofitting later.
//
//   • GDPR - Articles 17 (erasure, 30-day deadline) and 20
//                     (portability, structured machine-readable format).
//                     Portability ≠ erasure - separate requests.
//                     Applies the moment any EU resident uses the app.
//                     Source: ICO + EDPB Guidelines 05/2019
//
//   • HIPAA §164.312(b) - 7 mandatory audit fields (OCR-verified):
//                     user_id, role_snapshot, action, resource type+id,
//                     UTC timestamp, source ip+ua, outcome+status_code.
//                     PLUS: access_purpose (required for break-glass).
//                     Minimum 6-year log retention.
//                     Logs must be append-only / WORM (2026 update).
//                     Source: verticomply.com + censinet.com + HHS
//
//   • RBAC - Roles: patient | family_admin | doctor | system_admin
//   • Zero-Trust - Session + IP tracking, MFA enforced
//
// ================================================================
// Universal table conventions:
//   • UUID primary keys via gen_random_uuid()
//   • Soft-delete: is_deleted, deleted_at, deleted_by_id
//   • Audit trail: created_at, updated_at, created_by_id, updated_by_id
//   • FHIR resource ID stored alongside internal ID where applicable
//   • No PHI stored in audit_logs (opaque IDs only - HIPAA §164.312)
// ================================================================

// ──────────────────────────────────────────────────────────────
// SECTION 1 - CORE IDENTITY & AUTHENTICATION
// ──────────────────────────────────────────────────────────────

Table users {
  id                    uuid        [pk, default: `gen_random_uuid()`]

  // Auth identifiers - at least one required
  phone_number          varchar(20) [unique, null, note: 'E.164 format: +923001234567']
  email                 varchar(255) [unique, null]
  password_hash         varchar(255) [null, note: 'null for phone-only or OAuth users']

  // Auth provider
  auth_provider         varchar(20) [not null, default: 'phone', note: 'phone | email | google | apple']
  oauth_provider_id     varchar(255) [null, note: 'ID from Google / Apple OAuth']

  // Account state
  is_active             boolean     [not null, default: true]
  is_email_verified     boolean     [not null, default: false]
  is_phone_verified     boolean     [not null, default: false]

  // MFA - mandatory per standards (Phase 1)
  mfa_enabled           boolean     [not null, default: true]

  // Data residency - GDPR / PDPA compliance
  data_region           varchar(10) [not null, default: 'PK', note: 'PK | EU | US | AE']

  // FHIR R4 Patient resource link
  fhir_patient_id       varchar(255) [unique, null]

  // Soft delete + GDPR erasure pipeline
  is_deleted            boolean     [not null, default: false]
  deleted_at            timestamp   [null]
  deleted_by_id         uuid        [null]
  deletion_reason       varchar(50) [null, note: 'user_request | admin | inactivity']
  scheduled_purge_at    timestamp   [null, note: '30-day grace period before permanent wipe']

  // Timestamps
  last_login_at         timestamp   [null]
  created_at            timestamp   [not null, default: `now()`]
  updated_at            timestamp   [not null, default: `now()`]

  indexes {
    phone_number         [name: 'idx_users_phone']
    email                [name: 'idx_users_email']
    is_deleted           [name: 'idx_users_is_deleted']
    data_region          [name: 'idx_users_data_region']
    fhir_patient_id      [name: 'idx_users_fhir_patient_id']
  }

  Note: 'Core auth entity. FHIR R4 Patient mapped. PHI encrypted AES-256 at rest. GDPR deletion pipeline built-in.'
}

Table user_profiles {
  id                       uuid         [pk, default: `gen_random_uuid()`]
  user_id                  uuid         [not null, unique, ref: > users.id]

  // Human-readable patient ID displayed in UI
  patient_id_display       varchar(20)  [unique, note: 'e.g. #MF-88291']

  // FHIR R4 Patient - Name & Demographics
  full_name                varchar(255) [not null]
  date_of_birth            date         [null]
  gender                   varchar(20)  [null, note: 'FHIR ValueSet: male | female | other | unknown']

  // Physical metrics (become FHIR Observations on extraction)
  height_cm                decimal(5,2) [null]
  weight_kg                decimal(5,2) [null]
  blood_group              varchar(10)  [null, note: 'A+ | A- | B+ | B- | O+ | O- | AB+ | AB-']
  bmi                      decimal(4,2) [null, note: 'Calculated and cached']

  // Profile photo
  profile_photo_url        varchar(500) [null]
  profile_photo_key        varchar(255) [null, note: 'S3 object key - never serve directly']

  // Onboarding completion tracking (UI: "60% complete")
  profile_completion_pct   integer      [not null, default: 0]

  // Soft delete
  is_deleted               boolean      [not null, default: false]
  deleted_at               timestamp    [null]
  deleted_by_id            uuid         [null]

  // Audit
  created_at               timestamp    [not null, default: `now()`]
  updated_at               timestamp    [not null, default: `now()`]
  created_by_id            uuid         [null]
  updated_by_id            uuid         [null]

  indexes {
    user_id              [name: 'idx_user_profiles_user_id']
    patient_id_display   [name: 'idx_user_profiles_patient_display_id']
  }

  Note: 'FHIR R4 Patient demographic data. Separated from auth for FHIR compatibility and clean SRP.'
}

Table user_otp_requests {
  id              uuid        [pk, default: `gen_random_uuid()`]
  user_id         uuid        [null, ref: > users.id, note: 'null before account creation']

  channel         varchar(10) [not null, note: 'sms | email']
  recipient       varchar(255) [not null, note: 'Phone number or email address']
  otp_hash        varchar(255) [not null, note: 'bcrypt hash - never stored as plaintext']

  purpose         varchar(30) [not null, note: 'registration | login | mfa | password_reset | share_confirmation']

  is_used         boolean     [not null, default: false]
  attempt_count   integer     [not null, default: 0]
  max_attempts    integer     [not null, default: 5]

  expires_at      timestamp   [not null]
  used_at         timestamp   [null]

  // Security context for audit
  ip_address      varchar(45) [null]
  user_agent      text        [null]

  created_at      timestamp   [not null, default: `now()`]

  indexes {
    (recipient, purpose) [name: 'idx_otp_recipient_purpose']
    expires_at           [name: 'idx_otp_expires_at']
  }

  Note: 'OTP lifecycle table. Hash stored (never plaintext). Auto-expire + max-attempt brute-force protection.'
}

Table user_sessions {
  id                   uuid        [pk, default: `gen_random_uuid()`]
  user_id              uuid        [not null, ref: > users.id]

  session_token_hash   varchar(255) [not null, unique, note: 'Hashed JWT or session token']
  refresh_token_hash   varchar(255) [unique, null]

  // Device fingerprint
  device_type          varchar(20) [null, note: 'ios | android | web']
  device_id            varchar(255) [null]
  device_name          varchar(255) [null]

  // Security context
  ip_address           varchar(45) [null]
  user_agent           text        [null]

  // Lifecycle
  is_active            boolean     [not null, default: true]
  last_activity_at     timestamp   [not null, default: `now()`]
  expires_at           timestamp   [not null]
  revoked_at           timestamp   [null]
  revoke_reason        varchar(50) [null, note: 'logout | security | admin | expired']

  created_at           timestamp   [not null, default: `now()`]

  indexes {
    user_id                  [name: 'idx_sessions_user_id']
    session_token_hash       [name: 'idx_sessions_token_hash']
    (user_id, is_active)     [name: 'idx_sessions_user_active']
    expires_at               [name: 'idx_sessions_expires_at']
  }

  Note: 'Active session management. Supports multi-device, token revocation, concurrent session limiting.'
}

Table push_notification_tokens {
  id          uuid        [pk, default: `gen_random_uuid()`]
  user_id     uuid        [not null, ref: > users.id]

  token       varchar(500) [not null]
  platform    varchar(10) [not null, note: 'ios | android']
  device_id   varchar(255) [null]
  is_active   boolean     [not null, default: true]

  created_at  timestamp   [not null, default: `now()`]
  updated_at  timestamp   [not null, default: `now()`]

  indexes {
    user_id              [name: 'idx_push_tokens_user_id']
    (user_id, platform)  [name: 'idx_push_tokens_user_platform']
  }

  Note: 'FCM / APNs device tokens for push notifications.'
}

// ──────────────────────────────────────────────────────────────
// SECTION 2 - RBAC: ROLES & PERMISSIONS
// ──────────────────────────────────────────────────────────────

Table roles {
  id              uuid        [pk, default: `gen_random_uuid()`]
  name            varchar(50) [not null, unique, note: 'patient | family_admin | doctor | system_admin']
  display_name    varchar(100) [not null]
  description     text        [null]
  is_system_role  boolean     [not null, default: false, note: 'System roles cannot be deleted']

  created_at      timestamp   [not null, default: `now()`]
  updated_at      timestamp   [not null, default: `now()`]

  Note: 'RBAC role definitions. System roles are immutable. Doctors get time-limited role assignments.'
}

Table permissions {
  id          uuid         [pk, default: `gen_random_uuid()`]
  codename    varchar(100) [not null, unique, note: 'e.g. records.view | records.upload | profile.edit | share.generate_qr']
  name        varchar(150) [not null]
  category    varchar(50)  [not null, note: 'records | profile | family | sharing | emergency | admin']

  created_at  timestamp    [not null, default: `now()`]

  Note: 'Granular permission definitions. Codenames are resource.action pairs.'
}

Table user_roles {
  id            uuid      [pk, default: `gen_random_uuid()`]
  user_id       uuid      [not null, ref: > users.id]
  role_id       uuid      [not null, ref: > roles.id]

  // Time-limited for doctor access (standards: "time-limited, read-only view")
  valid_from    timestamp [not null, default: `now()`]
  valid_until   timestamp [null, note: 'null = permanent. Set for doctor roles.']
  is_active     boolean   [not null, default: true]

  granted_by_id uuid      [null, ref: > users.id]

  created_at    timestamp [not null, default: `now()`]

  indexes {
    (user_id, role_id)   [unique, name: 'idx_user_roles_user_role']
    user_id              [name: 'idx_user_roles_user_id']
    (is_active, valid_until) [name: 'idx_user_roles_expiry']
  }

  Note: 'User-Role assignments. valid_until enables time-boxed doctor access as required by standards.'
}

Table role_permissions {
  id            uuid      [pk, default: `gen_random_uuid()`]
  role_id       uuid      [not null, ref: > roles.id]
  permission_id uuid      [not null, ref: > permissions.id]

  created_at    timestamp [not null, default: `now()`]

  indexes {
    (role_id, permission_id) [unique, name: 'idx_role_permissions_unique']
  }

  Note: 'Role-to-Permission mapping table.'
}

// ──────────────────────────────────────────────────────────────
// SECTION 3 - CONSENT MANAGEMENT (PDPA + GDPR)
// ──────────────────────────────────────────────────────────────

Table consent_records {
  id               uuid        [pk, default: `gen_random_uuid()`]
  user_id          uuid        [not null, ref: > users.id]

  // Consent classification
  consent_type     varchar(60) [not null, note: 'data_collection | health_data_processing | ai_analysis | marketing | third_party_sharing']
  policy_version   varchar(20) [not null, note: 'Version of Privacy Policy / ToS consented to, e.g. v1.2']

  is_granted       boolean     [not null]

  // Legal proof metadata
  ip_address       varchar(45) [null]
  user_agent       text        [null]
  jurisdiction     varchar(10) [null, note: 'PK | EU | US | AE']

  // Consent withdrawal
  withdrawn_at     timestamp   [null]
  withdrawal_reason text       [null]

  // IMMUTABLE - records are never updated; a new row is appended on each change
  created_at       timestamp   [not null, default: `now()`]

  indexes {
    (user_id, consent_type) [name: 'idx_consent_user_type']
    user_id                 [name: 'idx_consent_user_id']
    consent_type            [name: 'idx_consent_type']
  }

  Note: 'Immutable append-only consent history. PDPA + GDPR. New row on every grant or withdrawal. Never UPDATE this table.'
}

Table data_deletion_requests {
  id                      uuid        [pk, default: `gen_random_uuid()`]
  user_id                 uuid        [not null, ref: > users.id]

  request_type            varchar(20) [not null, note: 'full_deletion | partial_deletion | data_export']
  status                  varchar(20) [not null, default: 'pending', note: 'pending | processing | completed | failed']

  // Scope: JSON list of data categories (e.g. ["records","allergies"])
  scope                   text        [null]

  // Request origin
  requested_via           varchar(20) [null, note: 'app | email | support_ticket']
  ip_address              varchar(45) [null]

  // Lifecycle timestamps
  requested_at            timestamp   [not null, default: `now()`]
  // GDPR Article 17: erasure must be completed within 30 days of request
  // Source: ICO + EDPB guidance + GDPR text (verified June 2026)
  response_deadline_at    timestamp   [null, note: 'GDPR Art.17: must complete within 30 days. Set = requested_at + 30 days.']
  processing_started_at   timestamp   [null]
  completed_at            timestamp   [null]
  scheduled_purge_at      timestamp   [null, note: '30-day grace period after completed_at, then permanent wipe']

  // Error handling
  error_message           text        [null]
  retry_count             integer     [not null, default: 0]

  Note: 'GDPR Article 17 right to erasure pipeline. 30-day response SLA enforced via response_deadline_at. Tracks full lifecycle from request to permanent purge.'
}

// ──────────────────────────────────────────────────────────────
// SECTION 4 - FAMILY MANAGEMENT (FHIR Patient)
// ──────────────────────────────────────────────────────────────

Table family_members {
  id                uuid        [pk, default: `gen_random_uuid()`]
  owner_user_id     uuid        [not null, ref: > users.id]

  // FHIR R4 Patient resource link
  fhir_patient_id   varchar(255) [unique, null]

  // Demographics
  full_name         varchar(255) [not null]
  date_of_birth     date        [null]
  age               integer     [null, note: 'Cached; derive from dob where available']
  gender            varchar(20) [null, note: 'FHIR ValueSet: male | female | other | unknown']
  blood_group       varchar(10) [null]

  // Relationship & access level
  relationship      varchar(50) [not null, note: 'spouse | child | parent | sibling | grandparent | other']
  role              varchar(20) [not null, note: 'owner | caregiver | dependent']
  access_level      varchar(30) [not null, default: 'full', note: 'full | vitals_only | read_only']

  // Profile photo
  photo_url         varchar(500) [null]
  photo_key         varchar(255) [null]

  // Soft delete
  is_deleted        boolean     [not null, default: false]
  deleted_at        timestamp   [null]
  deleted_by_id     uuid        [null]

  // Audit
  created_at        timestamp   [not null, default: `now()`]
  updated_at        timestamp   [not null, default: `now()`]
  created_by_id     uuid        [null]
  updated_by_id     uuid        [null]

  indexes {
    owner_user_id               [name: 'idx_family_owner_user_id']
    (owner_user_id, is_deleted) [name: 'idx_family_owner_active']
    fhir_patient_id             [name: 'idx_family_fhir_patient_id']
  }

  Note: 'FHIR R4 Patient for family dependents. Role-based access per member. Supports Owner / Caregiver / Dependent roles.'
}

// ──────────────────────────────────────────────────────────────
// SECTION 5 - ALLERGIES (FHIR AllergyIntolerance + SNOMED CT)
// ──────────────────────────────────────────────────────────────

Table allergy_intolerances {
  id                    uuid        [pk, default: `gen_random_uuid()`]
  user_id               uuid        [not null, ref: > users.id]
  family_member_id      uuid        [null, ref: > family_members.id, note: 'null = belongs to primary user']

  // FHIR R4 AllergyIntolerance resource link
  fhir_resource_id      varchar(255) [null]

  // Substance (raw text + clinical code)
  substance_name        varchar(255) [not null, note: 'e.g. Penicillin, Pollen, Peanuts']
  snomed_code           varchar(50) [null, note: 'SNOMED CT concept ID']
  snomed_display        varchar(255) [null]

  // FHIR categorization
  category              varchar(20) [null, note: 'food | medication | environment | biologic']
  criticality           varchar(30) [null, note: 'low | high | unable-to-assess']

  // FHIR status fields
  clinical_status       varchar(20) [not null, default: 'active', note: 'active | inactive | resolved']
  verification_status   varchar(30) [not null, default: 'unconfirmed', note: 'confirmed | unconfirmed | entered-in-error']

  reaction_description  text        [null]

  // Provenance
  source                varchar(30) [not null, default: 'patient_reported', note: 'patient_reported | ai_extracted | clinician_entered | document_import']
  source_record_id      uuid        [null, ref: > medical_records.id, note: 'Source document if AI-extracted']

  onset_date            date        [null]
  recorded_date         date        [null]

  // AI extraction metadata (EU AI Act transparency)
  ai_extracted          boolean     [not null, default: false]
  ai_confidence         decimal(5,4) [null, note: '0.0 – 1.0 confidence score']
  ai_correction_flag    boolean     [not null, default: false, note: 'User flagged an AI extraction error']
  ai_correction_note    text        [null]

  // Soft delete
  is_deleted            boolean     [not null, default: false]
  deleted_at            timestamp   [null]
  deleted_by_id         uuid        [null]

  // Audit
  created_at            timestamp   [not null, default: `now()`]
  updated_at            timestamp   [not null, default: `now()`]
  created_by_id         uuid        [null]
  updated_by_id         uuid        [null]

  indexes {
    user_id                      [name: 'idx_allergies_user_id']
    (user_id, clinical_status)   [name: 'idx_allergies_user_status']
    snomed_code                  [name: 'idx_allergies_snomed']
    source_record_id             [name: 'idx_allergies_source_record']
  }

  Note: 'FHIR R4 AllergyIntolerance. SNOMED CT coded. AI confidence + correction flag per EU AI Act transparency requirements.'
}

// ──────────────────────────────────────────────────────────────
// SECTION 6 - CONDITIONS / DIAGNOSES (FHIR Condition + ICD-11 + SNOMED CT)
// ──────────────────────────────────────────────────────────────

Table conditions {
  id                    uuid        [pk, default: `gen_random_uuid()`]
  user_id               uuid        [not null, ref: > users.id]
  family_member_id      uuid        [null, ref: > family_members.id]

  // FHIR R4 Condition resource link
  fhir_resource_id      varchar(255) [null]

  // Condition description
  condition_name        varchar(255) [not null]

  // ICD-11 - primary per standards ("Every diagnosis extracted by AI must map to an ICD-11 code")
  // Verified format: 1A00.00–ZZ9Z.ZZ. Stem codes 4–6 chars. Post-coordination uses '/' and '&'.
  // Exclude letters O and I (confused with 0 and 1). Second position always a letter.
  icd11_code            varchar(30) [null, note: 'ICD-11 stem code e.g. 5A11 for Type 2 Diabetes. Up to 30 chars to allow post-coordination clusters.']
  icd11_display         varchar(255) [null]

  // SNOMED CT - secondary
  snomed_code           varchar(50) [null]
  snomed_display        varchar(255) [null]

  // FHIR Condition status fields
  category              varchar(30) [null, note: 'problem-list-item | encounter-diagnosis | health-concern']
  clinical_status       varchar(20) [not null, default: 'active', note: 'active | recurrence | relapse | inactive | remission | resolved']
  verification_status   varchar(30) [not null, default: 'unconfirmed', note: 'confirmed | unconfirmed | provisional | differential | refuted']
  severity              varchar(20) [null, note: 'mild | moderate | severe']

  // Clinical details
  onset_date            date        [null]
  abatement_date        date        [null, note: 'When condition resolved / went into remission']
  attending_physician   varchar(255) [null]
  care_plan_notes       text        [null]

  // Provenance
  source                varchar(30) [not null, default: 'patient_reported', note: 'patient_reported | ai_extracted | clinician_entered | lab_import | hl7_import']
  source_record_id      uuid        [null, ref: > medical_records.id]

  // AI extraction metadata
  ai_extracted          boolean     [not null, default: false]
  ai_confidence         decimal(5,4) [null]
  ai_correction_flag    boolean     [not null, default: false]
  ai_correction_note    text        [null]

  // Soft delete
  is_deleted            boolean     [not null, default: false]
  deleted_at            timestamp   [null]
  deleted_by_id         uuid        [null]

  // Audit
  created_at            timestamp   [not null, default: `now()`]
  updated_at            timestamp   [not null, default: `now()`]
  created_by_id         uuid        [null]
  updated_by_id         uuid        [null]

  indexes {
    user_id                      [name: 'idx_conditions_user_id']
    icd11_code                   [name: 'idx_conditions_icd11']
    snomed_code                  [name: 'idx_conditions_snomed']
    (user_id, clinical_status)   [name: 'idx_conditions_user_status']
    source_record_id             [name: 'idx_conditions_source_record']
  }

  Note: 'FHIR R4 Condition. ICD-11 primary + SNOMED CT secondary coding. AI confidence + correction tracking per EU AI Act.'
}

// ──────────────────────────────────────────────────────────────
// SECTION 7 - MEDICATIONS (FHIR MedicationRequest + WHO ATC)
// ──────────────────────────────────────────────────────────────

Table medications {
  id              uuid        [pk, default: `gen_random_uuid()`]

  // Medication catalog / formulary
  name            varchar(255) [not null]
  generic_name    varchar(255) [null]
  brand_name      varchar(255) [null]

  // WHO ATC coding - per standards ("Every medication extracted must map to an ATC code")
  // Verified format: exactly 7-char alphanumeric, 5-level hierarchy (e.g. A10BA02 = metformin)
  // Level 1: letter (anatomical group), L2: 2 digits, L3: letter, L4: letter, L5: 2 digits
  // Source: WHO Collaborating Centre atcddd.fhi.no + 2026 Guidelines for ATC Classification PDF
  atc_code        varchar(7)  [null, note: 'WHO ATC code, exactly 7 chars e.g. J01CA04 for Amoxicillin, A10BA02 for Metformin']
  atc_display     varchar(255) [null]

  // SNOMED CT
  snomed_code     varchar(50) [null]
  snomed_display  varchar(255) [null]

  // Drug classification
  dosage_form     varchar(50) [null, note: 'tablet | capsule | injection | syrup | inhaler | topical']
  strength        varchar(100) [null, note: 'e.g. 500mg, 10mg/5ml']

  created_at      timestamp   [not null, default: `now()`]
  updated_at      timestamp   [not null, default: `now()`]

  indexes {
    name         [name: 'idx_medications_name']
    atc_code     [name: 'idx_medications_atc_code']
    generic_name [name: 'idx_medications_generic_name']
  }

  Note: 'Medication catalog/formulary. WHO ATC coded. Referenced by medication_requests. Shared lookup table.'
}

Table medication_requests {
  id                      uuid        [pk, default: `gen_random_uuid()`]
  user_id                 uuid        [not null, ref: > users.id]
  family_member_id        uuid        [null, ref: > family_members.id]
  medication_id           uuid        [null, ref: > medications.id, note: 'null if not matched to catalog yet']

  // FHIR R4 MedicationRequest resource link
  fhir_resource_id        varchar(255) [null]

  // Raw extracted values (source of truth from document)
  medication_name_raw     varchar(255) [not null, note: 'Original text from OCR / extraction']
  dosage_instruction      text        [null, note: 'e.g. 500mg twice daily after food']
  dose_quantity           varchar(100) [null]
  dose_frequency          varchar(100) [null, note: 'BID | TID | once daily | PRN']
  route                   varchar(50) [null, note: 'oral | IV | topical | inhalation | sublingual']

  // FHIR status - MANDATORY in FHIR R4 MedicationRequest (1..1 cardinality)
  status                  varchar(20) [not null, default: 'active', note: 'FHIR R4 required. active | completed | cancelled | stopped | draft | entered-in-error']

  // FHIR intent - MANDATORY in FHIR R4 MedicationRequest (1..1 cardinality, verified hl7.org/fhir/R4/medicationrequest.html)
  intent                  varchar(30) [not null, default: 'order', note: 'FHIR R4 required. proposal | plan | order | original-order | reflex-order | filler-order | instance-order | option']

  // Clinical context
  prescribing_doctor      varchar(255) [null]
  prescribed_date         date        [null]
  start_date              date        [null]
  end_date                date        [null]
  duration_days           integer     [null]

  // Source document
  source_record_id        uuid        [null, ref: > medical_records.id]
  encounter_id            uuid        [null, ref: > encounters.id]

  // AI extraction metadata
  ai_extracted            boolean     [not null, default: false]
  ai_confidence           decimal(5,4) [null]
  ai_correction_flag      boolean     [not null, default: false]
  ai_correction_note      text        [null]

  // Soft delete
  is_deleted              boolean     [not null, default: false]
  deleted_at              timestamp   [null]
  deleted_by_id           uuid        [null]

  // Audit
  created_at              timestamp   [not null, default: `now()`]
  updated_at              timestamp   [not null, default: `now()`]
  created_by_id           uuid        [null]
  updated_by_id           uuid        [null]

  indexes {
    user_id                      [name: 'idx_med_requests_user_id']
    (user_id, status)            [name: 'idx_med_requests_user_status']
    source_record_id             [name: 'idx_med_requests_source_record']
    medication_id                [name: 'idx_med_requests_medication_id']
  }

  Note: 'FHIR R4 MedicationRequest. WHO ATC via medications catalog. Prescription extraction with raw text preserved.'
}

// ──────────────────────────────────────────────────────────────
// SECTION 8 - OBSERVATIONS / VITALS (FHIR Observation + LOINC)
// ──────────────────────────────────────────────────────────────

Table observations {
  id                      uuid         [pk, default: `gen_random_uuid()`]
  user_id                 uuid         [not null, ref: > users.id]
  family_member_id        uuid         [null, ref: > family_members.id]

  // FHIR R4 Observation resource link
  fhir_resource_id        varchar(255) [null]

  // LOINC coding - per standards ("Every lab result extracted must map to a LOINC code")
  // Verified format: numeric string + hyphen + 1-digit check (e.g. 2339-0, 8867-4)
  // Defined by 6 axes: component, property, time-aspect, system (specimen), scale, method
  // Source: Regenstrief Institute loinc.org + ISA Reference March 2026
  loinc_code              varchar(20)  [null, note: 'LOINC code: numeric-checkdigit e.g. 2339-0 (blood glucose), 8867-4 (heart rate), 55284-4 (BP panel)']
  loinc_display           varchar(255) [null]

  // Observation classification
  observation_category    varchar(30)  [not null, note: 'vital-signs | laboratory | imaging | survey']
  observation_name        varchar(255) [not null]

  // FHIR Observation status
  status                  varchar(30)  [not null, default: 'final', note: 'registered | preliminary | final | amended | corrected | cancelled | entered-in-error']

  // Value (polymorphic - matches FHIR value[x])
  value_quantity          decimal(12,4) [null]
  value_unit              varchar(50)  [null, note: 'mg/dL | BPM | mmHg | g/dL | °C | %']
  value_string            varchar(255) [null]
  value_boolean           boolean      [null]

  // Reference ranges and interpretation
  reference_range_low     decimal(12,4) [null]
  reference_range_high    decimal(12,4) [null]
  interpretation          varchar(20)  [null, note: 'FHIR ValueSet: N | L | H | LL | HH | A | AA']

  // Timing
  effective_datetime      timestamp    [null, note: 'When the observation was actually made']
  issued_datetime         timestamp    [null, note: 'When the result was issued / reported']

  body_site               varchar(100) [null]

  // Provenance
  source_record_id        uuid         [null, ref: > medical_records.id]
  encounter_id            uuid         [null, ref: > encounters.id]

  // AI extraction metadata
  ai_extracted            boolean      [not null, default: false]
  ai_confidence           decimal(5,4) [null]
  ai_correction_flag      boolean      [not null, default: false]
  ai_correction_note      text         [null]

  // Soft delete
  is_deleted              boolean      [not null, default: false]
  deleted_at              timestamp    [null]
  deleted_by_id           uuid         [null]

  // Audit
  created_at              timestamp    [not null, default: `now()`]
  updated_at              timestamp    [not null, default: `now()`]
  created_by_id           uuid         [null]
  updated_by_id           uuid         [null]

  indexes {
    user_id                              [name: 'idx_observations_user_id']
    loinc_code                           [name: 'idx_observations_loinc']
    (user_id, observation_category)      [name: 'idx_observations_user_category']
    effective_datetime                   [name: 'idx_observations_effective_dt']
    source_record_id                     [name: 'idx_observations_source_record']
    (user_id, loinc_code, effective_datetime) [name: 'idx_observations_trend_query']
  }

  Note: 'FHIR R4 Observation. Mandatory FHIR fields: status (1..1) and code (1..1) - covered by status + loinc_code fields. LOINC format verified: numeric-hyphen-checkdigit. Trend query index included for AI analytics feature.'
}

Table observation_components {
  id                  uuid         [pk, default: `gen_random_uuid()`]
  observation_id      uuid         [not null, ref: > observations.id]

  // For multi-component observations (e.g. blood pressure = systolic + diastolic)
  loinc_code          varchar(20)  [null]
  loinc_display       varchar(255) [null]
  component_name      varchar(255) [not null]

  value_quantity      decimal(12,4) [null]
  value_unit          varchar(50)  [null]
  value_string        varchar(255) [null]

  created_at          timestamp    [not null, default: `now()`]

  indexes {
    observation_id [name: 'idx_obs_components_observation_id']
  }

  Note: 'Sub-components for complex FHIR Observations (e.g. blood pressure systolic/diastolic). LOINC coded per component.'
}

// ──────────────────────────────────────────────────────────────
// SECTION 9 - ENCOUNTERS (FHIR Encounter)
// ──────────────────────────────────────────────────────────────

Table encounters {
  id                      uuid        [pk, default: `gen_random_uuid()`]
  user_id                 uuid        [not null, ref: > users.id]
  family_member_id        uuid        [null, ref: > family_members.id]

  // FHIR R4 Encounter resource link
  fhir_resource_id        varchar(255) [null]

  // Encounter type and status
  encounter_type          varchar(30) [not null, note: 'consultation | lab_visit | vaccination | surgery | emergency | follow_up | pharmacy']
  status                  varchar(20) [not null, default: 'finished', note: 'planned | arrived | in-progress | finished | cancelled']

  // Description
  title                   varchar(255) [not null]
  description             text        [null]

  // Clinical actors
  practitioner_name       varchar(255) [null]
  practitioner_specialty  varchar(100) [null]
  organization_name       varchar(255) [null]

  // Timing
  start_datetime          timestamp   [null]
  end_datetime            timestamp   [null]

  // Vaccination-specific
  batch_number            varchar(100) [null, note: 'Vaccine batch ID e.g. #FL-90210']

  // Provenance
  source_record_id        uuid        [null, ref: > medical_records.id]

  // AI extraction metadata
  ai_extracted            boolean     [not null, default: false]
  ai_confidence           decimal(5,4) [null]
  ai_correction_flag      boolean     [not null, default: false]
  ai_correction_note      text        [null]

  // Soft delete
  is_deleted              boolean     [not null, default: false]
  deleted_at              timestamp   [null]
  deleted_by_id           uuid        [null]

  // Audit
  created_at              timestamp   [not null, default: `now()`]
  updated_at              timestamp   [not null, default: `now()`]
  created_by_id           uuid        [null]
  updated_by_id           uuid        [null]

  indexes {
    user_id                      [name: 'idx_encounters_user_id']
    (user_id, encounter_type)    [name: 'idx_encounters_user_type']
    start_datetime               [name: 'idx_encounters_start_dt']
    source_record_id             [name: 'idx_encounters_source_record']
  }

  Note: 'FHIR R4 Encounter. Covers consultations, lab visits, vaccinations, surgeries. Drives the Medical Timeline UI view.'
}

// ──────────────────────────────────────────────────────────────
// SECTION 10 - RECORDS VAULT (FHIR DocumentReference)
// ──────────────────────────────────────────────────────────────

Table record_folders {
  id          uuid        [pk, default: `gen_random_uuid()`]
  user_id     uuid        [not null, ref: > users.id]

  name        varchar(100) [not null, note: 'e.g. Cardiology | Dental | Eyesight']
  icon        varchar(50) [null, note: 'tooth | eye | heart | database | folder | prescription | bone']
  sort_order  integer     [not null, default: 0]

  // Soft delete
  is_deleted  boolean     [not null, default: false]
  deleted_at  timestamp   [null]
  deleted_by_id uuid      [null]

  // Audit
  created_at  timestamp   [not null, default: `now()`]
  updated_at  timestamp   [not null, default: `now()`]
  created_by_id uuid      [null]
  updated_by_id uuid      [null]

  indexes {
    user_id              [name: 'idx_record_folders_user_id']
    (user_id, is_deleted) [name: 'idx_record_folders_user_active']
  }

  Note: 'User-defined organizational folders for medical records. Drives "Folders" section in Records Vault UI.'
}

Table medical_records {
  id                        uuid         [pk, default: `gen_random_uuid()`]
  user_id                   uuid         [not null, ref: > users.id]
  family_member_id          uuid         [null, ref: > family_members.id]
  folder_id                 uuid         [null, ref: > record_folders.id]

  // FHIR R4 DocumentReference resource link
  fhir_resource_id          varchar(255) [null]

  // Document metadata
  title                     varchar(255) [not null]
  record_type               varchar(30)  [not null, note: 'prescription | lab_result | medical_report | x_ray | mri | ct_scan | vaccination | discharge_summary | other']
  record_date               date         [null, note: 'User-supplied date at upload time']
  document_date             date         [null, note: 'Date printed on the document, extracted by the AI pipeline. NULL = unknown, never assumed recent']

  // Secure file storage
  file_key                  varchar(500) [not null, note: 'S3/GCS object key - never serve directly; generate pre-signed URLs']
  file_name                 varchar(255) [not null]
  file_mime_type            varchar(100) [not null, note: 'application/pdf | image/jpeg | image/png | application/dicom']
  file_size_bytes           bigint       [not null]
  file_hash                 varchar(64)  [null, note: 'SHA-256 hash for integrity verification']

  // Clinical context (from OCR / AI extraction)
  patient_name_on_doc       varchar(255) [null, note: 'Patient name as printed on the document']
  laboratory_name           varchar(255) [null]
  referring_doctor          varchar(255) [null]
  issuing_organization      varchar(255) [null]

  // Processing pipeline state
  processing_status         varchar(20)  [not null, default: 'pending', note: 'pending | processing | completed | failed | requires_review']
  processing_error          text         [null]

  // AI summary (generated on upload < 30s per standards SLA)
  ai_summary                text         [null]
  ai_summary_generated_at   timestamp    [null]
  ai_summary_model_version  varchar(50)  [null, note: 'Track model used for audit & quality review']

  // DICOM support (Phase 2 per standards)
  is_dicom                  boolean      [not null, default: false]
  dicom_study_instance_uid  varchar(255) [null]
  dicom_series_instance_uid varchar(255) [null]
  dicom_sop_class_uid       varchar(255) [null]

  // Soft delete with GDPR erasure type
  is_deleted                boolean      [not null, default: false]
  deleted_at                timestamp    [null]
  deleted_by_id             uuid         [null]
  deletion_type             varchar(20)  [null, note: 'user_request | admin_action | gdpr_erasure | cascade']

  // Audit
  uploaded_at               timestamp    [not null, default: `now()`]
  created_at                timestamp    [not null, default: `now()`]
  updated_at                timestamp    [not null, default: `now()`]
  created_by_id             uuid         [null]
  updated_by_id             uuid         [null]

  indexes {
    user_id                           [name: 'idx_medical_records_user_id']
    (user_id, record_type)            [name: 'idx_medical_records_user_type']
    (user_id, is_deleted)             [name: 'idx_medical_records_user_active']
    folder_id                         [name: 'idx_medical_records_folder_id']
    record_date                       [name: 'idx_medical_records_date']
    document_date                     [name: 'idx_medical_records_document_date']
    processing_status                 [name: 'idx_medical_records_processing_status']
    family_member_id                  [name: 'idx_medical_records_family_member_id']
  }

  Note: 'FHIR R4 DocumentReference. AES-256 encrypted at rest. File keys only - no raw URLs stored permanently. DICOM-ready for Phase 2.'
}

// ──────────────────────────────────────────────────────────────
// SECTION 11 - EMERGENCY (Widget + Contacts)
// ──────────────────────────────────────────────────────────────

Table emergency_settings {
  id                        uuid      [pk, default: `gen_random_uuid()`]
  user_id                   uuid      [not null, unique, ref: > users.id]

  // Lock screen widget
  lock_screen_widget_enabled boolean  [not null, default: false]

  // What PHI to expose on lock screen
  show_blood_group          boolean   [not null, default: true]
  show_allergies            boolean   [not null, default: true]
  show_emergency_contacts   boolean   [not null, default: true]
  show_chronic_conditions   boolean   [not null, default: false]

  // Audit
  created_at                timestamp [not null, default: `now()`]
  updated_at                timestamp [not null, default: `now()`]
  updated_by_id             uuid      [null]

  Note: 'Emergency lock screen widget configuration. Controls which PHI fields are exposed without authentication.'
}

Table emergency_contacts {
  id            uuid        [pk, default: `gen_random_uuid()`]
  user_id       uuid        [not null, ref: > users.id]

  full_name     varchar(255) [not null, note: 'e.g. Sarah Johnson (Wife)']
  relationship  varchar(100) [null]
  phone_number  varchar(20) [not null, note: 'E.164 format']
  is_primary    boolean     [not null, default: false]
  sort_order    integer     [not null, default: 0]

  // Soft delete
  is_deleted    boolean     [not null, default: false]
  deleted_at    timestamp   [null]
  deleted_by_id uuid        [null]

  // Audit
  created_at    timestamp   [not null, default: `now()`]
  updated_at    timestamp   [not null, default: `now()`]
  created_by_id uuid        [null]
  updated_by_id uuid        [null]

  indexes {
    user_id              [name: 'idx_emergency_contacts_user_id']
    (user_id, is_primary) [name: 'idx_emergency_contacts_primary']
  }

  Note: 'SOS / emergency contacts. Displayed on lock screen widget if enabled. Primary contact shown first.'
}

// ──────────────────────────────────────────────────────────────
// SECTION 12 - DOCTOR SHARING (QR + Persistent Access)
// ──────────────────────────────────────────────────────────────

Table doctor_share_sessions {
  id                      uuid        [pk, default: `gen_random_uuid()`]
  user_id                 uuid        [not null, ref: > users.id]

  // QR token stored as hash (raw token lives in QR code only)
  qr_token_hash           varchar(255) [not null, unique]

  // Sharing scope
  share_scope             varchar(30) [not null, note: 'last_1_year | last_6_months | complete_history | emergency_only']

  // Lifecycle
  status                  varchar(20) [not null, default: 'active', note: 'active | scanned | expired | revoked']
  expires_at              timestamp   [not null, note: 'created_at + 10 minutes per UI design']
  scanned_at              timestamp   [null]
  revoked_at              timestamp   [null]
  revoke_reason           varchar(50) [null]

  // Post-scan doctor context (self-reported for audit)
  scanned_by_name         varchar(255) [null]
  scanned_by_institution  varchar(255) [null]
  scanned_ip              varchar(45) [null]
  scanned_user_agent      text        [null]

  created_at              timestamp   [not null, default: `now()`]

  indexes {
    user_id          [name: 'idx_doctor_share_user_id']
    qr_token_hash    [name: 'idx_doctor_share_token_hash']
    expires_at       [name: 'idx_doctor_share_expires_at']
    status           [name: 'idx_doctor_share_status']
  }

  Note: 'Time-limited QR sharing sessions. Token hashed. 10-minute expiry. Full scan context captured for HIPAA audit.'
}

Table data_sharing_consents {
  id                    uuid        [pk, default: `gen_random_uuid()`]
  user_id               uuid        [not null, ref: > users.id]

  // Grantee details
  grantee_name          varchar(255) [null]
  grantee_type          varchar(20) [not null, note: 'doctor | hospital | lab | third_party_app']
  grantee_institution   varchar(255) [null]

  // Access scope
  access_scope          varchar(30) [not null, note: 'full | prescriptions_only | lab_results_only | vitals_only | emergency_only']

  // Validity window
  granted_at            timestamp   [not null, default: `now()`]
  expires_at            timestamp   [null, note: 'null = until revoked']
  revoked_at            timestamp   [null]
  revoke_reason         text        [null]

  status                varchar(20) [not null, default: 'active', note: 'active | expired | revoked']

  // Audit
  created_at            timestamp   [not null, default: `now()`]
  updated_at            timestamp   [not null, default: `now()`]

  indexes {
    user_id             [name: 'idx_data_sharing_user_id']
    (user_id, status)   [name: 'idx_data_sharing_user_status']
  }

  Note: 'Persistent data sharing consents for clinics, doctors, hospitals. Distinct from short-lived QR sessions. Data Sharing Agreement (DSA) backed.'
}

// ──────────────────────────────────────────────────────────────
// SECTION 13 - ALERTS / NOTIFICATIONS
// ──────────────────────────────────────────────────────────────

Table alerts {
  id                    uuid        [pk, default: `gen_random_uuid()`]
  user_id               uuid        [not null, ref: > users.id]

  // Content
  title                 varchar(255) [not null]
  message               text        [not null]

  // Classification
  alert_type            varchar(40) [not null, note: 'drug_interaction | high_vital | low_vital | emergency_flag | lab_ready | system_update | reminder | compliance']
  priority              varchar(20) [not null, default: 'info', note: 'critical | high | attention | info | system_update']
  category              varchar(30) [not null, note: 'medication | vitals | profile | records | emergency | compliance']

  // Read state
  is_read               boolean     [not null, default: false]
  read_at               timestamp   [null]
  is_dismissed          boolean     [not null, default: false]
  dismissed_at          timestamp   [null]

  // Linked entity (polymorphic)
  linked_entity_type    varchar(30) [null, note: 'medical_record | observation | condition | medication_request | encounter']
  linked_entity_id      uuid        [null]

  // Push delivery tracking
  push_delivered        boolean     [not null, default: false]
  push_delivered_at     timestamp   [null]

  // Soft delete
  is_deleted            boolean     [not null, default: false]
  deleted_at            timestamp   [null]

  created_at            timestamp   [not null, default: `now()`]

  indexes {
    user_id                       [name: 'idx_alerts_user_id']
    (user_id, is_read)            [name: 'idx_alerts_user_unread']
    (user_id, created_at)         [name: 'idx_alerts_user_timeline']
    priority                      [name: 'idx_alerts_priority']
    (user_id, is_deleted, is_read) [name: 'idx_alerts_active_unread']
  }

  Note: 'Alert center. Drug interactions, high vitals, emergency flags, lab results, system updates. Priority-ranked display.'
}

// ──────────────────────────────────────────────────────────────
// SECTION 14 - AI CHAT ASSISTANT
// ──────────────────────────────────────────────────────────────

Table ai_chat_sessions {
  id                        uuid      [pk, default: `gen_random_uuid()`]
  user_id                   uuid      [not null, ref: > users.id]

  title                     varchar(255) [null, note: 'Auto-generated from first user message']
  status                    varchar(20) [not null, default: 'active', note: 'active | archived | deleted']

  // Standards compliance: AI disclaimer must be shown on every response
  total_messages            integer   [not null, default: 0]
  disclaimer_shown_count    integer   [not null, default: 0]

  // Soft delete
  is_deleted                boolean   [not null, default: false]
  deleted_at                timestamp [null]

  created_at                timestamp [not null, default: `now()`]
  updated_at                timestamp [not null, default: `now()`]

  indexes {
    user_id             [name: 'idx_ai_sessions_user_id']
    (user_id, status)   [name: 'idx_ai_sessions_user_active']
  }

  Note: 'AI chat session container. Tracks disclaimer exposure count - required by standards and EU AI Act.'
}

Table ai_chat_messages {
  id                    uuid        [pk, default: `gen_random_uuid()`]
  session_id            uuid        [not null, ref: > ai_chat_sessions.id]
  user_id               uuid        [not null, ref: > users.id]

  role                  varchar(10) [not null, note: 'user | assistant | system']
  content               text        [not null]

  // AI transparency (standards: "cite source document/record")
  source_record_ids     text        [null, note: 'JSON array of medical_records.id used as context']

  // AI safety / disclaimer compliance (standards: "disclaimer on every AI response")
  disclaimer_included   boolean     [not null, default: false]
  disclaimer_text       text        [null, note: 'Exact disclaimer shown - logged for audit trail']
  disclaimer_language   varchar(10) [null, note: 'en | ur | ar (multilingual per standards)']

  // Model transparency (EU AI Act: users must know they talk to AI + which model)
  model_version         varchar(50) [null, note: 'e.g. gpt-4o-2024-11 | claude-3-5-sonnet']

  // AI confidence transparency
  confidence_level      varchar(20) [null, note: 'high | medium | low | uncertain']

  // AI error correction mechanism (standards requirement)
  flagged_for_review    boolean     [not null, default: false]
  flag_reason           text        [null]
  flagged_at            timestamp   [null]

  // Cost / quality monitoring
  prompt_tokens         integer     [null]
  completion_tokens     integer     [null]

  created_at            timestamp   [not null, default: `now()`]

  indexes {
    session_id                    [name: 'idx_ai_messages_session_id']
    user_id                       [name: 'idx_ai_messages_user_id']
    (session_id, created_at)      [name: 'idx_ai_messages_session_timeline']
    flagged_for_review            [name: 'idx_ai_messages_flagged']
  }

  Note: 'AI chat messages. Disclaimer logged per message. Source records cited. Correction mechanism included. EU AI Act compliant.'
}

// ──────────────────────────────────────────────────────────────
// SECTION 15 - APP SETTINGS & PREFERENCES
// ──────────────────────────────────────────────────────────────

Table app_settings {
  id                            uuid      [pk, default: `gen_random_uuid()`]
  user_id                       uuid      [not null, unique, ref: > users.id]

  // UI
  language                      varchar(10) [not null, default: 'en', note: 'en | ur | ar']
  theme                         varchar(10) [not null, default: 'dark', note: 'dark | light']

  // Security
  biometric_lock_enabled        boolean   [not null, default: false]

  // Notifications
  push_notifications_enabled    boolean   [not null, default: true]
  email_notifications_enabled   boolean   [not null, default: true]
  drug_interaction_alerts       boolean   [not null, default: true]
  lab_result_alerts             boolean   [not null, default: true]
  vital_threshold_alerts        boolean   [not null, default: true]

  // Privacy - GDPR Privacy by Design (opt-out by default)
  analytics_opt_in              boolean   [not null, default: false, note: 'GDPR: opt-in required, default false']

  updated_at                    timestamp [not null, default: `now()`]

  Note: 'Per-user app settings. Analytics opt-in defaults to false - GDPR privacy by design principle.'
}

// ──────────────────────────────────────────────────────────────
// SECTION 16 - AUDIT LOGGING (IMMUTABLE - per standards)
// ──────────────────────────────────────────────────────────────

Table audit_logs {
  id                      uuid        [pk, default: `gen_random_uuid()`]

  // Actor context (who)
  actor_user_id           uuid        [null, note: 'null for unauthenticated or system-initiated actions']
  actor_role_snapshot     varchar(50) [null, note: 'Role at time of action (denormalized for immutability)']
  actor_ip                varchar(45) [null]
  actor_device_type       varchar(20) [null, note: 'ios | android | web | api | system']
  actor_user_agent        text        [null]

  // Action (what)
  action                  varchar(50) [not null, note: 'view | download | upload | share | delete | update | create | login | logout | mfa_verify | export | admin_access']

  // Target resource (what was accessed)
  resource_type           varchar(50) [not null, note: 'medical_record | user_profile | condition | observation | medication_request | allergy | encounter | doctor_share | ai_chat | emergency_settings']
  resource_id             uuid        [null]
  resource_owner_user_id  uuid        [null, note: 'Whose data was accessed - key for cross-user access auditing']

  // Request context
  http_method             varchar(10) [null]
  endpoint                varchar(255) [null]
  request_id              varchar(100) [null, note: 'Distributed tracing correlation ID']

  // Outcome
  outcome_status          varchar(20) [not null, note: 'success | failure | unauthorized | not_found | rate_limited']
  http_status_code        integer     [null]
  error_message           text        [null]

  // Access purpose - required by HIPAA §164.312(b) for break-glass and emergency access
  // Verified: OCR investigators expect this field for any non-routine PHI access
  access_purpose          varchar(30) [null, note: 'treatment | payment | operations | break_glass | emergency | audit_review | support']
  break_glass_reason      text        [null, note: 'Mandatory justification text when access_purpose = break_glass']

  // Extended context (schema-flexible without migrations)
  additional_context      jsonb       [null]

  // Tamper detection - append-only / WORM compliance (HIPAA 2026 Security Rule update)
  // Hash of (previous_row_hash || this_row_content) enables cryptographic chain verification
  hash_chain_value        varchar(64) [null, note: 'SHA-256 hash chain value for WORM tamper detection']

  // NO updated_at / NO is_deleted / NO soft-delete - this table is IMMUTABLE
  // HIPAA §164.312(b): minimum 6-year retention. Use WORM / append-only storage (S3 Object Lock, Azure Immutable Blob).
  // Maps to FHIR R4 AuditEvent resource (IHE BALP IG). Do NOT store PHI directly - use opaque resource_id.
  created_at              timestamp   [not null, default: `now()`]

  indexes {
    actor_user_id                       [name: 'idx_audit_actor_user']
    resource_owner_user_id              [name: 'idx_audit_resource_owner']
    (resource_type, resource_id)        [name: 'idx_audit_resource']
    created_at                          [name: 'idx_audit_created_at']
    action                              [name: 'idx_audit_action']
    (actor_user_id, created_at)         [name: 'idx_audit_actor_timeline']
    (resource_owner_user_id, created_at) [name: 'idx_audit_owner_timeline']
  }

  Note: 'IMMUTABLE. Every PHI access logged. No UPDATE or DELETE ever permitted. Store in separate schema or DB from primary data. Required by PDPA, HIPAA, GDPR.'
}

// ──────────────────────────────────────────────────────────────
// SECTION 17 - FHIR / HL7 INTEGRATION LAYER
// ──────────────────────────────────────────────────────────────

Table fhir_resource_mappings {
  id                      uuid        [pk, default: `gen_random_uuid()`]

  // Internal resource reference
  internal_resource_type  varchar(50) [not null, note: 'medical_record | condition | observation | medication_request | allergy_intolerance | encounter | user_profile | family_member']
  internal_resource_id    uuid        [not null]

  // FHIR mapping
  fhir_resource_type      varchar(50) [not null, note: 'Patient | Observation | MedicationRequest | Condition | DocumentReference | AllergyIntolerance | Encounter']
  fhir_resource_id        varchar(255) [not null]
  fhir_server_url         varchar(500) [null, note: 'null = internal FHIR server']
  fhir_version            varchar(10) [not null, default: 'R4']

  // Source system for HL7 v2 / clinic imports
  source_system           varchar(100) [null, note: 'e.g. HIS_SHIFA | LAB_AGH | EMR_CERNER | HL7V2_PARSER']
  source_system_id        varchar(255) [null, note: 'Record ID in the originating system']

  // Sync state
  last_synced_at          timestamp   [null]
  sync_status             varchar(20) [null, note: 'synced | pending | failed | conflict']
  sync_error_message      text        [null]

  created_at              timestamp   [not null, default: `now()`]
  updated_at              timestamp   [not null, default: `now()`]

  indexes {
    (internal_resource_type, internal_resource_id) [unique, name: 'idx_fhir_mapping_internal_unique']
    (fhir_resource_type, fhir_resource_id)         [name: 'idx_fhir_mapping_fhir_resource']
    source_system                                  [name: 'idx_fhir_mapping_source_system']
    sync_status                                    [name: 'idx_fhir_mapping_sync_status']
  }

  Note: 'Bidirectional FHIR R4 resource ID mapping. Supports HL7 v2 legacy import (Phase 2). Required before first clinic integration.'
}

Table integration_tokens {
  id                        uuid        [pk, default: `gen_random_uuid()`]
  user_id                   uuid        [not null, ref: > users.id]

  provider                  varchar(50) [not null, note: 'google_health | apple_health | lab_agh | shifa_ehr | cerner | epic']
  provider_type             varchar(20) [not null, note: 'ehr | lab | pharmacy | wearable | insurance']

  // OAuth 2.0 tokens - AES-256 encrypted at rest
  access_token_encrypted    text        [null, note: 'AES-256 encrypted OAuth access token']
  refresh_token_encrypted   text        [null, note: 'AES-256 encrypted OAuth refresh token']
  token_type                varchar(20) [null]
  scope                     text        [null, note: 'Space-delimited OAuth scopes granted']

  token_expires_at          timestamp   [null]
  is_active                 boolean     [not null, default: true]
  revoked_at                timestamp   [null]
  revoke_reason             varchar(50) [null]

  created_at                timestamp   [not null, default: `now()`]
  updated_at                timestamp   [not null, default: `now()`]

  indexes {
    user_id                      [name: 'idx_integration_tokens_user_id']
    (user_id, provider)          [unique, name: 'idx_integration_tokens_user_provider']
    (is_active, token_expires_at) [name: 'idx_integration_tokens_active_expiry']
  }

  Note: 'OAuth 2.0 tokens for EHR, lab, and wearable integrations. Tokens AES-256 encrypted. Per standards: never expose raw keys.'
}

// ──────────────────────────────────────────────────────────────
// SECTION 18 - DATA PORTABILITY (GDPR Article 20)
// ──────────────────────────────────────────────────────────────

Table data_export_requests {
  id                    uuid        [pk, default: `gen_random_uuid()`]
  user_id               uuid        [not null, ref: > users.id]

  export_format         varchar(20) [not null, default: 'json', note: 'json | fhir_bundle | csv | pdf']
  status                varchar(20) [not null, default: 'pending', note: 'pending | processing | ready | downloaded | expired | failed']

  // What to export
  scope                 text        [null, note: 'JSON list of data categories; null = full export']

  // File
  file_key              varchar(500) [null, note: 'S3 key for the generated export archive']
  file_size_bytes       bigint      [null]
  download_url_expires_at timestamp [null, note: 'Pre-signed URL expiry']
  download_count        integer     [not null, default: 0]

  // Lifecycle
  requested_at          timestamp   [not null, default: `now()`]
  // GDPR Article 20: portability export must be provided within 30 days
  // Portability right is SEPARATE from erasure right - they do not trigger each other (EDPB Guidelines 05/2019)
  // Portability applies only to data provided/observed by the user, NOT to AI-inferred data
  response_deadline_at  timestamp   [null, note: 'GDPR Art.20: must deliver within 30 days. Set = requested_at + 30 days.']
  processing_started_at timestamp   [null]
  completed_at          timestamp   [null]
  file_expires_at       timestamp   [null, note: 'When the export file is automatically purged from storage']

  error_message         text        [null]

  Note: 'GDPR Article 20 data portability. 30-day SLA via response_deadline_at. Supports fhir_bundle/json/csv. Excludes AI-inferred data (EDPB Guidelines 05/2019). Distinct from erasure - separate request required.'
}

// ──────────────────────────────────────────────────────────────
// SECTION 19 - BREACH NOTIFICATION LOG (PDPA + HIPAA)
// ──────────────────────────────────────────────────────────────

Table security_incidents {
  id                      uuid        [pk, default: `gen_random_uuid()`]

  incident_type           varchar(50) [not null, note: 'data_breach | unauthorized_access | failed_mfa_flood | suspicious_export | api_abuse']
  severity                varchar(20) [not null, note: 'critical | high | medium | low']
  status                  varchar(20) [not null, default: 'open', note: 'open | investigating | contained | resolved | closed']

  description             text        [not null]

  // Affected scope
  affected_user_id        uuid        [null, ref: > users.id]
  affected_user_count     integer     [null]
  affected_data_types     text        [null, note: 'JSON list of PHI categories affected']

  // Discovery and notification
  discovered_at           timestamp   [not null]
  notified_users_at       timestamp   [null]
  // ⚠️  Pakistan PDPB 2023: 72-hour notification is PROPOSED (Bill not yet enacted as of June 2026).
  // Treat as binding NOW to avoid retrofitting when it passes.
  // GDPR (enforceable now for EU users): 72-hour supervisory authority notification is legally required.
  notified_regulator_at   timestamp   [null, note: 'GDPR: 72h to supervisory authority. PDPB (proposed): 72h to NCPDP. Track regardless.']

  // Resolution
  resolved_at             timestamp   [null]
  remediation_notes       text        [null]
  post_mortem_url         varchar(500) [null]

  // Audit
  reported_by_id          uuid        [null, ref: > users.id]
  created_at              timestamp   [not null, default: `now()`]
  updated_at              timestamp   [not null, default: `now()`]

  indexes {
    severity                   [name: 'idx_incidents_severity']
    status                     [name: 'idx_incidents_status']
    affected_user_id            [name: 'idx_incidents_affected_user']
    discovered_at               [name: 'idx_incidents_discovered_at']
  }

  Note: 'Security incident and breach notification log. PDPA requires 72h regulator notification. HIPAA breach notification tracking.'
}
